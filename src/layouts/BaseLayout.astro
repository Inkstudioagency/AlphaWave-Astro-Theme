---
import { Font } from 'astro:assets';
import SeoMeta, { type Props as SeoProps } from '@/components/SeoMeta.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

// Stylesheet order matches the template: normalize -> webflow -> theme -> interactions -> lenis
import '@/styles/normalize.css';
import '@/styles/webflow.css';
import '@/styles/alphawave.css';
import '@/styles/webflow-ix.css';
import 'lenis/dist/lenis.css';

interface Props extends SeoProps {
  /**
   * Webflow page id. webflow.js uses it to load each page's interactions (IX3),
   * so every page keeps the id it had in the original template.
   */
  wfPage: string;
  /** Utility pages (e.g. the password page) render without header and footer */
  bare?: boolean;
  /** Extra class on the .page-wrapper element */
  wrapperClass?: string;
}

const { wfPage, bare = false, wrapperClass, ...seo } = Astro.props;
// Webflow site id the bundled interactions were published with
const WF_SITE = '6abf3fb2113c777049f29442';
---

<!doctype html>
<html data-wf-page={wfPage} data-wf-site={WF_SITE} lang="en">
  <head>
    <SeoMeta {...seo} />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-literata" />
    <script is:inline>!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
    <link href="/images/favicon.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" />
    <link href="/images/favicon-dark.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link href="/images/favicon-48.png" rel="icon" type="image/png" sizes="48x48" />
    <link href="/images/webclip-180.png" rel="apple-touch-icon" sizes="180x180" />
    <link href="/images/webclip-192.png" rel="icon" type="image/png" sizes="192x192" />
    <link href="/images/webclip.png" rel="icon" type="image/png" sizes="512x512" />
  </head>
  <body>
    <div class:list={['page-wrapper', wrapperClass]}>
      {bare ? (
        <slot />
      ) : (
        <>
          <Header />
          <main class="main-wrapper">
            <slot />
          </main>
          <Footer wfPage={wfPage} />
        </>
      )}
    </div>
    <script is:inline src="/js/jquery-3.5.1.min.js"></script>
    <script is:inline src="/js/webflow.js"></script>
    <script>
      import '@/scripts/forms';
      import '@/scripts/animations';
    </script>
  </body>
</html>

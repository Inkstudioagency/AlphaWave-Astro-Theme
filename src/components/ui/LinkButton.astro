---
import { WF_COMPONENTS, currentLinkProps, wfTarget } from '@/lib/webflow';

interface Props {
  href: string;
  label: string;
  instance: string[];
}

const { href, label, instance } = Astro.props;
const c = WF_COMPONENTS.linkButton;
const link = currentLinkProps(href, Astro.url.pathname, 'link-button w-inline-block');
---

<a
  data-wf-target={wfTarget(c.id, c.id, instance)}
  data-wf-component-id={c.id}
  data-wf-variant-state="base"
  href={href}
  {...link}
>
  <div class="button-text-mask">
    <div data-wf-target={wfTarget(c.id, c.text, instance)} class="link-button-text">{label}</div>
    <div aria-hidden="true" data-wf-target={wfTarget(c.id, c.hoverText, instance)} class="link-button-text is-hover">{label}</div>
  </div>
  <div data-wf-target={wfTarget(c.id, c.icon, instance)} class="button-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M18.5 12.002H5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      <path d="M13 18.002C13 18.002 19 13.583 19 12.002C19 10.421 13 6.002 13 6.002" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg></div>
</a>

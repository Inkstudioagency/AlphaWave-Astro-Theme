---
// Converted from Template/licenses.html (section_licenses)
---

<section class="section_licenses">
  <div class="w-layout-blockcontainer container-main w-container">
    <div class="licenses-list">
      <div page-load-4="" class="licenses-item">
        <div class="licenses-item-head">
          <div class="licenses-item-icon"><svg stroke-linejoin="round" stroke-linecap="round" stroke-width="1.75" stroke="currentColor" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="licenses-item-icon-svg licenses-item-icon-svg">
              <path d="M4 20h3"></path>
              <path d="M14 20h7"></path>
              <path d="M6.9 15h6.9"></path>
              <path d="M10.2 6.3 16 20"></path>
              <path d="m5 20 6-16h2l7 16"></path>
            </svg></div>
          <h2 class="heading-style-5">Fonts</h2>
        </div>
        <div class="licenses-entries">
          <div class="licenses-entry">
            <div class="licenses-entry-text">
              <h3 class="heading-style-6">Inter — SIL Open Font License</h3>
              <p class="text-size-regular">Typeface for headings, body text, navigation and buttons, designed by Rasmus Andersson. Served from Google Fonts under the SIL Open Font License, free for personal and commercial use.</p>
            </div>
            <a href="https://fonts.google.com/specimen/Inter/license" class="text-link">View license</a>
          </div>
          <div class="licenses-entry">
            <div class="licenses-entry-text">
              <h3 class="heading-style-6">Literata — SIL Open Font License</h3>
              <p class="text-size-regular">Accent typeface for the italic highlighted words in headings, designed by TypeTogether. Served from Google Fonts under the SIL Open Font License, free for personal and commercial use.</p>
            </div>
            <a href="https://fonts.google.com/specimen/Literata/license" class="text-link">View license</a>
          </div>
        </div>
      </div>
      <div reveal-anim-1="" class="licenses-item">
        <div class="licenses-item-head">
          <div class="licenses-item-icon"><svg stroke-linejoin="round" stroke-linecap="round" stroke-width="1.75" stroke="currentColor" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="licenses-item-icon-svg licenses-item-icon-svg">
              <path d="M15 8h.01"></path>
              <rect rx="3" height="16" width="18" y="4" x="3"></rect>
              <path d="m3 16 5-5c.9-.9 2.1-.9 3 0l5 5"></path>
              <path d="m14 14 1-1c.9-.9 2.1-.9 3 0l3 3"></path>
            </svg></div>
          <h2 class="heading-style-5">Images</h2>
        </div>
        <div class="licenses-entries">
          <div class="licenses-entry">
            <div class="licenses-entry-text">
              <h3 class="heading-style-6">Photography — Lummi License</h3>
              <p class="text-size-regular">All photos in this template come from Lummi and are free to use in personal and commercial projects under the Lummi license.</p>
            </div>
            <a href="https://www.lummi.ai/license" target="_blank" class="text-link">View license</a>
          </div>
        </div>
      </div>
      <div reveal-anim-2="" class="licenses-item">
        <div class="licenses-item-head">
          <div class="licenses-item-icon"><svg stroke-linejoin="round" stroke-linecap="round" stroke-width="1.75" stroke="currentColor" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="licenses-item-icon-svg licenses-item-icon-svg">
              <rect rx="1.5" height="6" width="6" y="4" x="4"></rect>
              <rect rx="1.5" height="6" width="6" y="4" x="14"></rect>
              <rect rx="1.5" height="6" width="6" y="14" x="4"></rect>
              <circle r="3" cy="17" cx="17"></circle>
            </svg></div>
          <h2 class="heading-style-5">Icons</h2>
        </div>
        <div class="licenses-entries">
          <div class="licenses-entry">
            <div class="licenses-entry-text">
              <h3 class="heading-style-6">Tabler Icons — MIT License</h3>
              <p class="text-size-regular">Interface icons come from Tabler Icons, free for personal and commercial use under the MIT License. They use currentColor, so they follow the text color.</p>
            </div>
            <a href="https://tabler.io/license" target="_blank" class="text-link">View license</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

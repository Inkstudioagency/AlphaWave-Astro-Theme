---
// Service page hero (data from Strapi)
import type { Service } from '@/lib/content';

interface Props {
  service: Service;
}
const { service } = Astro.props;
const author = service.author;
---

<section class="section_service-details-hero">
  <div class="container-main">
    <div class="service-details-hero-card">
      <div class="hero-glow"></div>
      <div class="service-details-hero-content">
        <div class="service-details-hero-top">
          <a href="/services" class="service-details-back-link w-inline-block">
            <div class="service-details-back-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M20 12L4 12M10 6L4 12L10 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg></div>
            <div class="service-details-back-text">Service</div>
          </a>
          <h1 hero-title="" class="hero-title">{service.name}</h1>
        </div>
        <div page-load-2="" class="service-details-author">
          <div class="service-details-author-label">Author</div>
          <div class="service-details-author-card">{author?.photo && <img src={author.photo.url} loading="lazy" alt={[author.name, author.role].filter(Boolean).join(', ')} class="service-details-author-photo" />}
            <div class="service-details-author-info">
              <div class="service-details-author-name">{author?.name}</div>
              <div class="service-details-author-role">{author?.role}</div>
            </div>
          </div>
        </div>
      </div>
      <div page-load-3="" class="service-details-hero-image-wrap"><img src={service.mainImage.url} loading="lazy" alt={service.mainImage.alt} class="service-details-hero-image" /></div>
    </div>
  </div>
</section>

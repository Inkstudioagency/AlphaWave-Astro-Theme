---
// Jobs list: the 12 most recently posted jobs from Strapi
import JobCard from '@/components/cards/JobCard.astro';
import EmptyState from '@/components/cards/EmptyState.astro';
import { getLatestJobs } from '@/lib/content';

const jobs = await getLatestJobs(12);
const instance = ['790213b4-3697-2c72-8281-66b7a0c03bc4_instance-0'];
---

<section class="section_jobs-list">
  <div class="container-main">
    <div class="jobs-list-wrapper">
      <div class="section-header-row is-jobs-filter">
        <h2 section-title="" class="heading-style-2">Latest <span class="heading-accent">Jobs</span></h2>
        <div class="jobs-filter-row">
          <div data-hover="false" data-delay="0" class="jobs-filter-dropdown w-dropdown">
            <div class="jobs-filter-toggle w-dropdown-toggle">
              <div class="jobs-filter-icon w-embed"><svg width="100%" height="100%" aria-hidden="true" focusable="false" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5.41667 7.5H4.58333M8.75 7.5H7.91667M5.41667 5H4.58333M8.75 5H7.91667" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"></path>
                  <path d="M15.4167 12.5H14.5833M15.4167 9.16667H14.5833" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"></path>
                  <path d="M11.6667 6.66667V18.3333H15C16.5713 18.3333 17.357 18.3333 17.8452 17.8452C18.3333 17.357 18.3333 16.5713 18.3333 15V10C18.3333 8.42867 18.3333 7.64297 17.8452 7.15482C17.357 6.66667 16.5713 6.66667 15 6.66667H11.6667ZM11.6667 6.66667C11.6667 4.30964 11.6667 3.13113 10.9344 2.3989C10.2022 1.66667 9.02367 1.66667 6.66667 1.66667C4.30964 1.66667 3.13113 1.66667 2.3989 2.3989C1.66667 3.13113 1.66667 4.30964 1.66667 6.66667V8.33333" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M6.68773 11.6295C6.68773 12.5494 5.94156 13.2949 5.02111 13.2949C4.10067 13.2949 3.35449 12.5494 3.35449 11.6295C3.35449 10.7098 4.10067 9.96419 5.02111 9.96419C5.94156 9.96419 6.68773 10.7098 6.68773 11.6295Z" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"></path>
                  <path d="M1.72566 16.8415C2.60762 15.4847 4.0082 14.9762 5.02157 14.9772C6.03495 14.9783 7.39448 15.4847 8.27644 16.8415C8.33345 16.9292 8.34915 17.0372 8.29771 17.1284C8.09145 17.4939 7.45105 18.2191 6.9885 18.2683C6.45703 18.3248 5.06676 18.3327 5.02265 18.333C4.9785 18.3327 3.54531 18.3248 3.0136 18.2683C2.55105 18.2191 1.91065 17.4939 1.70439 17.1284C1.65293 17.0372 1.66864 16.9292 1.72566 16.8415Z" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"></path>
                </svg></div>
              <div class="jobs-filter-label">Industry</div>
              <div class="jobs-filter-icon is-chevron w-embed"><svg width="100%" height="100%" aria-hidden="true" focusable="false" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M15 7.50004C15 7.50004 11.3176 12.5 10 12.5C8.68233 12.5 5 7.5 5 7.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg></div>
            </div>
            <nav class="jobs-filter-list w-dropdown-list">
              <a href="/jobs" aria-current="page" class="jobs-filter-link is-filter w-dropdown-link w--current">Technology</a>
              <a href="/jobs" aria-current="page" class="jobs-filter-link is-filter w-dropdown-link w--current">Healthcare</a>
              <a href="/jobs" aria-current="page" class="jobs-filter-link is-filter w-dropdown-link w--current">Finance</a>
              <a href="/jobs" aria-current="page" class="jobs-filter-link is-filter w-dropdown-link w--current">Marketing</a>
              <a href="/jobs" aria-current="page" class="jobs-filter-link is-filter w-dropdown-link w--current">Design</a>
            </nav>
          </div>
          <div data-hover="false" data-delay="0" class="jobs-filter-dropdown w-dropdown">
            <div class="jobs-filter-toggle w-dropdown-toggle">
              <div class="jobs-filter-icon w-embed"><svg width="100%" height="100%" aria-hidden="true" focusable="false" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12.5 2.04817C11.7108 1.80029 10.871 1.66667 10 1.66667C5.39762 1.66667 1.66667 5.39762 1.66667 10C1.66667 14.6023 5.39762 18.3333 10 18.3333C14.6023 18.3333 18.3333 14.6023 18.3333 10C18.3333 9.129 18.1997 8.2892 17.9518 7.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M12.5 8.33333C12.5 9.71408 11.3807 10.8333 10 10.8333C8.61925 10.8333 7.5 9.71408 7.5 8.33333C7.5 6.95263 8.61925 5.83333 10 5.83333C11.3807 5.83333 12.5 6.95263 12.5 8.33333Z" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M4.58333 16.25L5.05033 15.4328C5.79218 14.1346 7.17278 13.3333 8.66805 13.3333H11.332C12.8272 13.3333 14.2078 14.1346 14.9496 15.4328L15.4166 16.25" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M15.8114 1.68457C15.8163 1.6607 15.8504 1.6607 15.8553 1.68457C16.1085 2.9234 17.0766 3.89153 18.3154 4.14473C18.3394 4.14962 18.3394 4.18372 18.3154 4.1886C17.0766 4.4418 16.1085 5.40993 15.8553 6.64877C15.8504 6.67263 15.8163 6.67263 15.8114 6.64877C15.5582 5.40993 14.5901 4.4418 13.3513 4.1886C13.3274 4.18372 13.3274 4.14962 13.3513 4.14473C14.5901 3.89153 15.5582 2.9234 15.8114 1.68457Z" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg></div>
              <div class="jobs-filter-label">Experience</div>
              <div class="jobs-filter-icon is-chevron w-embed"><svg width="100%" height="100%" aria-hidden="true" focusable="false" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M15 7.50004C15 7.50004 11.3176 12.5 10 12.5C8.68233 12.5 5 7.5 5 7.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg></div>
            </div>
            <nav class="jobs-filter-list w-dropdown-list">
              <a href="/jobs" aria-current="page" class="jobs-filter-link is-filter w-dropdown-link w--current">Entry Level</a>
              <a href="/jobs" aria-current="page" class="jobs-filter-link is-filter w-dropdown-link w--current">1–3 Years</a>
              <a href="/jobs" aria-current="page" class="jobs-filter-link is-filter w-dropdown-link w--current">3–5 Years</a>
              <a href="/jobs" aria-current="page" class="jobs-filter-link is-filter w-dropdown-link w--current">5+ Years</a>
            </nav>
          </div>
          <div data-hover="false" data-delay="0" class="jobs-filter-dropdown w-dropdown">
            <div class="jobs-filter-toggle w-dropdown-toggle">
              <div class="jobs-filter-icon w-embed"><svg width="100%" height="100%" aria-hidden="true" focusable="false" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M11.3481 17.8058C10.9867 18.1442 10.5037 18.3333 10.0009 18.3333C9.49817 18.3333 9.01517 18.1442 8.65375 17.8058C5.34418 14.6883 0.908967 11.2058 3.07189 6.14972C4.24136 3.41597 7.04862 1.66667 10.0009 1.66667C12.9532 1.66667 15.7605 3.41597 16.93 6.14972C19.0902 11.1994 14.6658 14.6991 11.3481 17.8058Z" stroke="currentColor" stroke-width="1.25"></path>
                  <path d="M12.9167 9.16667C12.9167 10.7775 11.6108 12.0833 10 12.0833C8.38917 12.0833 7.08333 10.7775 7.08333 9.16667C7.08333 7.55583 8.38917 6.25 10 6.25C11.6108 6.25 12.9167 7.55583 12.9167 9.16667Z" stroke="currentColor" stroke-width="1.25"></path>
                </svg></div>
              <div class="jobs-filter-label">Location</div>
              <div class="jobs-filter-icon is-chevron w-embed"><svg width="100%" height="100%" aria-hidden="true" focusable="false" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M15 7.50004C15 7.50004 11.3176 12.5 10 12.5C8.68233 12.5 5 7.5 5 7.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg></div>
            </div>
            <nav class="jobs-filter-list w-dropdown-list">
              <a href="/jobs" aria-current="page" class="jobs-filter-link is-filter w-dropdown-link w--current">Remote</a>
              <a href="/jobs" aria-current="page" class="jobs-filter-link is-filter w-dropdown-link w--current">New York</a>
              <a href="/jobs" aria-current="page" class="jobs-filter-link is-filter w-dropdown-link w--current">London</a>
              <a href="/jobs" aria-current="page" class="jobs-filter-link is-filter w-dropdown-link w--current">Dubai</a>
              <a href="/jobs" aria-current="page" class="jobs-filter-link is-filter w-dropdown-link w--current">Singapore</a>
            </nav>
          </div>
        </div>
      </div>
      <div class="jobs-list-collection">
        <div class="w-dyn-list">
          {jobs.length > 0 ? (
            <div role="list" class="jobs-list-grid w-dyn-items">
              {jobs.map((job) => (
                <div reveal-anim-3="" role="listitem" class="jobs-list-item w-dyn-item">
                  <JobCard job={job} instance={instance} />
                </div>
              ))}
            </div>
          ) : <EmptyState />}
        </div>
      </div>
    </div>
  </div>
</section>

---
// Blog slider shared by the Home, About and Services pages (latest posts from Strapi)
import BlogCard from '@/components/cards/BlogCard.astro';
import EmptyState from '@/components/cards/EmptyState.astro';
import { getLatestPosts } from '@/lib/content';

const posts = await getLatestPosts(6);
---

<section class="section_blog">
  <div class="container-main">
    <div class="home-blog-wrapper">
      <div class="section-title-center">
        <h2 section-title="" class="heading-style-2 is-blog-title">Stay Updated With <span class="heading-accent">News &amp; Insights</span></h2>
      </div>
      <div class="home-blog-list-wrap">
        <div data-delay="4000" data-animation="slide" class="blog-slider w-slider" data-autoplay="false" data-easing="ease" data-hide-arrows="false" data-disable-swipe="false" data-autoplay-limit="0" data-nav-spacing="3" data-duration="500" data-infinite="true" reveal-anim-3="">
          <div class="blog-slider-mask w-slider-mask">
            {posts.map((post) => (
              <div class="blog-slide w-slide">
                <div class="blog-slider-collection w-dyn-list">
                  <div role="list" class="blog-slider-list w-dyn-items">
                    <div role="listitem" class="home-blog-item w-dyn-item">
                      <BlogCard post={post} />
                    </div>
                  </div>
                </div>
              </div>
            ))}
            {posts.length === 0 && (
              <div class="blog-slide w-slide">
                <div class="blog-slider-collection w-dyn-list">
                  <EmptyState />
                </div>
              </div>
            )}
          </div>
          <div class="blog-slider-arrow w-slider-arrow-left">
            <div class="blog-slider-arrow-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M5.5 12.002H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M11 18.002C11 18.002 5 13.583 5 12.002C5 10.421 11 6.002 11 6.002" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg></div>
          </div>
          <div class="blog-slider-arrow is-next w-slider-arrow-right">
            <div class="blog-slider-arrow-icon w-embed"><svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M18.5 12.002H5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M13 18.002C13 18.002 19 13.583 19 12.002C19 10.421 13 6.002 13 6.002" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg></div>
          </div>
          <div class="blog-slider-nav w-slider-nav w-round w-num"></div>
        </div>
      </div>
    </div>
  </div>
</section>

// Converted from Template/index.html (section_home-process)
---

<section class="section_home-process">
  <div class="w-layout-blockcontainer container-main w-container">
    <div class="process-grid">
      <div class="process-left">
        <h2 section-title="" class="heading-style-2">Getting Started With <span class="heading-accent">AlphaWave</span> Is Easy</h2><img class="process-image" src="/images/process-happy-client.webp" alt="Happy client raising her hand while working on a laptop" sizes="100vw" reveal-anim-2="" loading="lazy" srcset="/images/process-happy-client-p-500.webp 500w, /images/process-happy-client-p-800.webp 800w, /images/process-happy-client.webp 908w">
      </div>
      <div class="process-steps">
        <div reveal-anim-3="" class="process-step">
          <div class="process-number">1<span class="process-dot">.</span></div>
          <div class="process-step-content">
            <h3 class="process-step-title">Share Your Hiring Needs</h3>
            <p class="process-step-text">Tell us about your company, open positions, required skills, and hiring goals. Our recruitment specialists take the time to understand your business and the ideal candidate profile.</p>
          </div>
        </div>
        <div reveal-anim-4="" class="process-step">
          <div class="process-number">2<span class="process-dot">.</span></div>
          <div class="process-step-content">
            <h3 class="process-step-title">We Source The Best Talent</h3>
            <p class="process-step-text">Using our extensive talent network and proven screening process, we identify, evaluate, and shortlist qualified candidates who match your technical requirements and company culture.</p>
          </div>
        </div>
        <div reveal-anim-5="" class="process-step">
          <div class="process-number">3<span class="process-dot">.</span></div>
          <div class="process-step-content">
            <h3 class="process-step-title">Interview, Hire &amp; Onboard</h3>
            <p class="process-step-text">Review shortlisted candidates, conduct interviews, and hire with confidence. We support you throughout the recruitment journey to ensure a smooth hiring and onboarding experience.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
